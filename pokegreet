# ---------- config & data ----------

def die(msg):
    sys.exit(f"pokegreet: {msg}")


def parse_mmdd(s, what):
    try:
        month, day = (int(x) for x in str(s).split("-"))
        datetime.date(2000, month, day)  # validates (2000 is a leap year, so 02-29 is allowed)
        return month, day
    except ValueError:
        die(f"bad {what} {s!r} in {CONFIG_FILE}, expected \"MM-DD\"")


def load_config():
    cfg = {**DEFAULTS, "colors": dict(DEFAULTS["colors"])}
    if os.path.exists(CONFIG_FILE):
        try:
            import tomllib
        except ImportError:
            die(f"reading {CONFIG_FILE} needs Python 3.11+ (or remove the file to use defaults)")
        try:
            with open(CONFIG_FILE, "rb") as f:
                user = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            die(f"couldn't parse {CONFIG_FILE}: {e}")
        unknown = set(user) - set(DEFAULTS)
        if unknown:
            die(f"unknown setting(s) in {CONFIG_FILE}: {', '.join(sorted(unknown))}")
        colors = user.pop("colors", {})
        unknown = set(colors) - set(DEFAULTS["colors"])
        if unknown:
            die(f"unknown colour(s) in {CONFIG_FILE}: {', '.join(sorted(unknown))} "
                f"(available: {', '.join(DEFAULTS['colors'])})")
        cfg["colors"].update(colors)
        cfg.update(user)
    cfg["birthday"] = parse_mmdd(cfg["birthday"], "birthday") if cfg["birthday"] else None
    cfg["exam_windows"] = [(parse_mmdd(a, "exam window"), parse_mmdd(b, "exam window"))
                           for a, b in cfg["exam_windows"]]
    cfg["colors"] = {k: sgr(v) for k, v in cfg["colors"].items()}
    if cfg["style"] not in STYLES:
        die(f"unknown style {cfg['style']!r} in {CONFIG_FILE} (available: {', '.join(STYLES)})")
    if cfg["border"] not in BORDERS:
        die(f"unknown border {cfg['border']!r} in {CONFIG_FILE} (available: {', '.join(BORDERS)})")
    return cfg


def sgr(color):
    """Colour spec (name, 0-255 index or #rrggbb) -> SGR parameter string."""
    if isinstance(color, str) and color.startswith("#") and len(color) == 7:
        r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
        return f"38;2;{r};{g};{b}"
    if color == "default":
        return "39"
    idx = COLOR_NAMES.get(color, color)
    if isinstance(idx, int) and 0 <= idx <= 255:
        return str(30 + idx) if idx < 8 else str(82 + idx) if idx < 16 else f"38;5;{idx}"
    die(f"bad colour {color!r} in {CONFIG_FILE}: use a name like \"green\", 0-255, or \"#rrggbb\"")


def find_data_dir():
    candidates = [os.environ.get("POKEGREET_COLORSCRIPTS_DIR")]
    exe = shutil.which("pokemon-colorscripts")
    if exe:
        candidates.append(os.path.dirname(os.path.realpath(exe)))
    candidates += ["/usr/local/opt/pokemon-colorscripts", "/opt/pokemon-colorscripts",
                   "/usr/share/pokemon-colorscripts", os.path.expanduser("~/.local/opt/pokemon-colorscripts"),
                   os.path.expanduser("~/.local/share/pokemon-colorscripts")]
    for d in candidates:
        if d and os.path.exists(os.path.join(d, "pokemon.json")):
            return d
    die(f"couldn't find pokemon-colorscripts. Install it from {COLORSCRIPTS_URL}\n"
        "  or point POKEGREET_COLORSCRIPTS_DIR at the folder containing pokemon.json")


