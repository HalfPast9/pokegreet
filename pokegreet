def real_season(t, cfg):
    """Meteorological seasons: Dec-Feb is winter in the north, summer in the south."""
    month = t.month if cfg["hemisphere"] != "south" else (t.month + 5) % 12 + 1
    return {12: "winter", 1: "winter", 2: "winter", 3: "spring", 4: "spring", 5: "spring",
            6: "summer", 7: "summer", 8: "summer"}.get(month, "autumn")


def lycanroc_form(h):
    return "regular" if 6 <= h < 17 else "dusk" if h < 19 else "midnight"


def necrozma_form(h):
    return "dawn" if 5 <= h < 8 else "ultra" if h == 12 else "dusk" if 17 <= h < 20 else "regular"


