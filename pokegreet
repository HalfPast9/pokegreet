def in_windows(t, windows):
    return any(start <= (t.month, t.day) <= end for start, end in windows)


# ---------- formatting ----------

COLORS = {}


def c(role, text, bold=False):
    return f"\x1b[{'1;' if bold else ''}{COLORS[role]}m{text}\x1b[0m"


def pretty_name(name):
    return SPECIAL_NAMES.get(name, name.replace("-", " ").title())


def pretty_form(form):
    return " ".join(SPECIAL_FORMS.get(w, w.title()) for w in form.split("-"))


def display_title(name, form):
    title = pretty_name(name)
    if form == "regular":
        return title
    if form in SPECIAL_FORMS or form.startswith("mega"):
        return f"{pretty_form(form)} {title}"
    return f"{title} ({pretty_form(form)})"


def bar(n, total, width=10):
    filled = round(width * n / total) if total else 0
    if n and not filled:
        filled = 1
    return "▰" * filled + "▱" * (width - filled)


def gen_info(dex_no):
    for last, region, roman in GENS:
        if dex_no <= last:
            return region, roman
    return "???", "?"


# ---------- dex storage ----------

def empty_dex():
    return {"encounters": 0, "seen": {}}


def read_dex():
    try:
        with open(DEX_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return empty_dex()


def with_dex(update, save=True):
    """Locked read-modify-write so simultaneous terminals don't clobber each other."""
    if not save:
        return update(read_dex())
    os.makedirs(os.path.dirname(DEX_FILE), exist_ok=True)
    with open(DEX_FILE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        dex = read_dex()
        result = update(dex)
        tmp = DEX_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(dex, f, indent=1)
        os.replace(tmp, DEX_FILE)
    return result


def shiny_count(dex):
    return sum(1 for e in dex["seen"].values() if e["shiny_forms"])


# ---------- encounter ----------

def resolve(pool, species):
    """Drop pool entries the installed sprite set doesn't have (older/newer data)."""
    forms = {p["name"]: p["forms"] for p in species}
    out = []
    for entry in pool:
        name, _, glob = entry.partition(":")
        if name in forms and (not glob or fnmatch.filter(forms[name], glob)):
            out.append(entry)
    return out


def active_theme(t, cfg, species):
    disabled = set(cfg["disabled"])
    for event in EVENTS:
        if (t.month, t.day) in event["dates"] and event["id"] not in disabled:
            if event.get("always") or random.randrange(cfg["event_odds"]) == 0:
                return event
            break
    rolls = [(theme, cfg["theme_odds"]) for theme in THEMES if theme["active"](t, cfg)]
    rolls.append((SEASONS[real_season(t, cfg)], cfg["season_odds"]))
    random.shuffle(rolls)  # so overlapping themes share fairly
    for theme, odds in rolls:
        if theme["id"] not in disabled and random.randrange(odds) == 0:
            return theme
    return None


def pick(species, t, cfg):
    index = {p["name"]: i for i, p in enumerate(species)}
    theme = active_theme(t, cfg, species)
    pool = resolve(theme["pool"], species) if theme else []
    form_glob = None
    if pool:
        name, _, form_glob = random.choice(pool).partition(":")
        idx = index[name]
    else:
        theme = None
        idx = random.randrange(len(species))
    name, forms = species[idx]["name"], species[idx]["forms"]

    if form_glob:
        form = random.choice(fnmatch.filter(forms, form_glob))
    elif name in FORM_RULES and FORM_RULES[name](t, cfg) in forms:
        form = FORM_RULES[name](t, cfg)
    else:
        alts = [f for f in forms if f != "regular"]
        form = random.choice(alts) if alts and random.randrange(cfg["alt_form_odds"]) == 0 else "regular"

    birthday = cfg["birthday"] == (t.month, t.day)
    shiny = birthday or random.randrange(cfg["shiny_odds"]) == 0
    disguise = random.randrange(len(species)) if theme and theme.get("disguise") else None
    return {"idx": idx, "form": form, "shiny": shiny, "birthday": birthday,
            "footer": theme and theme.get("footer"), "disguise": disguise}


def read_sprite(name, form, shiny):
    fname = name if form == "regular" else f"{name}-{form}"
    with open(os.path.join(DATA_DIR, "colorscripts", "small", "shiny" if shiny else "regular", fname)) as f:
        sprite = [line + "\x1b[0m" for line in f.read().split("\n")]
    while sprite and not ANSI_RE.sub("", sprite[-1]).strip():
        sprite.pop()
    return sprite


def build_encounter(cfg, t, save=True):
    """Roll and record an encounter; returns (sprite, panel parts)."""
    species = load_species()
    enc = pick(species, t, cfg)
    idx, form, shiny = enc["idx"], enc["form"], enc["shiny"]
    name, forms = species[idx]["name"], species[idx]["forms"]

    def record(dex):
        dex["encounters"] += 1
        entry = dex["seen"].get(name)
        new_species = entry is None
        if new_species:
            entry = dex["seen"][name] = {
                "count": 0, "first": t.date().isoformat(), "forms": [], "shiny_forms": [],
            }
        entry["count"] += 1
        new_form = form not in entry["forms"]
        if new_form:
            entry["forms"].append(form)
        new_shiny = shiny and form not in entry["shiny_forms"]
        if new_shiny:
            entry["shiny_forms"].append(form)
        return {
            "new_species": new_species, "new_form": new_form, "new_shiny": new_shiny,
            "count": entry["count"], "forms_seen": len(entry["forms"]),
            "seen_total": len(dex["seen"]), "shiny_total": shiny_count(dex),
        }

    r = with_dex(record, save)

    # an April Fools' disguise shows someone else's sprite and name
    shown_name, shown_form = (species[enc["disguise"]]["name"], "regular") if enc["disguise"] is not None else (name, form)
    sprite = read_sprite(shown_name, shown_form, shiny)

    dex_no = idx + 1
    region, roman = gen_info(dex_no)
    title = display_title(name, form)
    shown_title = display_title(shown_name, shown_form)
    total = len(species)

    if shiny:
        head = [c("gold", f"✨ A wild shiny {shown_title} appeared! ✨", bold=True)]
    else:
        head = [c("text", "A wild ", bold=True) + c("accent", shown_title, bold=True) + c("text", " appeared!", bold=True)]
    if enc["disguise"] is not None:
        head.append(c("text", "…wait, it's actually ") + c("accent", title, bold=True) + c("text", "! 🎭"))
    stats = [c("dim", "Pokédex   ") + c("accent", bar(r["seen_total"], total)) + c("dim", f" {r['seen_total']}/{total}"),
             c("dim", "Shiny dex ") + c("gold", bar(r["shiny_total"], total)) + c("dim", f" {r['shiny_total']}/{total}")]
    if len(forms) > 1:
        stats.append(c("dim", "Forms     ") + c("accent", bar(r["forms_seen"], len(forms)))
                     + c("dim", f" {r['forms_seen']}/{len(forms)} {pretty_name(name)} forms"))
    notes = []
    if r["new_shiny"]:
        notes.append(c("gold", "★ NEW shiny registered!", bold=True))
    if r["new_species"]:
        notes.append(c("new", "NEW!", bold=True) + c("text", " Registered to your Pokédex."))
    elif r["new_form"]:
        notes.append(c("new", "NEW form!", bold=True) + c("text", f" {pretty_form(form)} registered."))
    elif not r["new_shiny"]:
        notes.append(c("dim", f"Seen {r['count']} times."))
    if enc["birthday"]:
        who = f", {cfg['name']}" if cfg["name"] else ""
        notes.append(c("gold", f"🎂 Happy birthday{who}! A shiny, just for you.", bold=True))
    if not save:
        notes.append(c("dim", f"(preview of {t:%Y-%m-%d %H:%M}, not saved)"))

    parts = {"head": head, "info": c("dim", f"#{dex_no:03d} · {region} · Gen {roman}"), "stats": stats,
             "notes": notes, "footer": c("dim", enc["footer"]) if enc["footer"] else ""}
    return sprite, parts


def show_styles(cfg, t):
    """The same (unsaved) encounter in every style, to help pick one for the config."""
    sprite, parts = build_encounter(cfg, t, save=False)
    parts["notes"] = parts["notes"][:-1]  # drop the "preview, not saved" line
    for style in STYLES:
        print()
        print(c("gold", f' style = "{style}"', bold=True) + c("dim", "  (default)" if style == DEFAULTS["style"] else ""))
        print()
        render(sprite, parts, {**cfg, "style": style})
    print()
    print(c("dim", f" Set one in {CONFIG_FILE}, along with border = round | square | double | heavy"))


def width(s):
    """Display width: ANSI codes take no space, emoji take two cells."""
    return sum(0 if ch == "\ufe0f" else 2 if unicodedata.east_asian_width(ch) in "WF" else 1
               for ch in ANSI_RE.sub("", s))


def pad(s, n):
    return s + " " * (n - width(s))


def beside(left, right, gap=3):
    """Two blocks side by side, both vertically centred."""
    left_w = max(map(width, left), default=0)
    height = max(len(left), len(right))
    lt, rt = (height - len(left)) // 2, (height - len(right)) // 2
    out = []
    for i in range(height):
        l = left[i - lt] if 0 <= i - lt < len(left) else ""
        r = right[i - rt] if 0 <= i - rt < len(right) else ""
        out.append((pad(l, left_w) + " " * gap + r).rstrip(" "))
    return out


def box(lines, cfg, title="", footer="", min_width=0, border=None, color="border"):
    """Frame lines in a border, with optional labels set into the top and bottom edges."""
    tl, tr, bl, br, hz, vt = BORDERS[border or cfg["border"]]
    inner = max([width(l) for l in lines] + [width(title) + 4, width(footer) + 4, min_width])

    def edge(left, right, label):
        if not label:
            return c(color, left + hz * (inner + 2) + right)
        return c(color, left + hz + " ") + label + c(color, " " + hz * (inner - width(label) - 1) + right)

    return ([edge(tl, tr, title)]
            + [c(color, vt) + " " + pad(l, inner) + " " + c(color, vt) for l in lines]
            + [edge(bl, br, footer)])


def compose(sprite, p, cfg, cols=None):
    """Lay out the sprite and info panel in the configured style.

    With `cols`, the panel sits beside the sprite, centred in the space to its right;
    without, the panel goes below the sprite.
    """
    side = cols is not None

    def join(left, right):
        if not side:
            return left + right
        free = cols - max(map(width, left), default=0) - max(map(width, right), default=0)
        return beside(left, right, gap=max(3, free // 2))

    plain = p["head"] + [p["info"], ""] + p["stats"] + [""] + p["notes"] + ([p["footer"]] if p["footer"] else [])
    style = cfg["style"]
    if style == "plain":
        return join(sprite, plain)
    if style == "stacked":
        sections = [("Encounter", p["head"] + [p["info"]]), ("Progress", p["stats"]),
                    ("Log", p["notes"] + ([p["footer"]] if p["footer"] else []))]
        inner = max(width(l) for _, ls in sections for l in ls)
        panels = [line for name, ls in sections
                  for line in box(ls, cfg, title=c("accent", name, bold=True), min_width=inner)]
        return join(sprite, panels)
    if style == "card":
        body = beside(sprite, plain, gap=2) if side else sprite + [""] + plain
        return box(body, cfg, title=c("accent", "Wild encounter", bold=True))
    if style == "dialog":
        stats = box(p["stats"] + [""] + p["notes"] + ([p["footer"]] if p["footer"] else []), cfg)
        return join(sprite, stats) + box(p["head"] + [p["info"]], cfg, border="double", color="text")
    if style == "rail":
        rail = c("accent", "▌") + " "
        return join(sprite, [rail + l for l in p["head"] + [p["info"]]] + [""]
                    + ["  " + l if l else "" for l in plain[len(p["head"]) + 2:]])
    # panel (default)
    return join(sprite, box(p["head"] + [""] + p["stats"] + [""] + p["notes"], cfg, title=p["info"], footer=p["footer"]))


def render(sprite, parts, cfg):
    cols = shutil.get_terminal_size((80, 24)).columns
    out = compose(sprite, parts, cfg, cols)
    if max(map(width, out)) > cols:  # too narrow for side by side
        out = compose(sprite, parts, cfg)
    print("\n".join(out))


# ---------- --dex ----------

def show_dex(query=None):
    species = load_species()
    dex = read_dex()
    seen = dex["seen"]

    if query:
        key = query.lower()
        match = next((i for i, p in enumerate(species) if p["name"] == key), None)
        if match is None:
            die(f"unknown pokemon '{query}' (see pokemon-colorscripts -l)")
        sp = species[match]
        entry = seen.get(key)
        print(c("accent", f"#{match + 1:03d} {pretty_name(key)}", bold=True))
        if not entry:
            print(c("dim", "Not seen yet."))
            return
        print(c("dim", f"Seen {entry['count']} times · first on {entry['first']}"))
        print()
        print(c("dim", f"{'form':<20} seen  shiny"))
        for f in sp["forms"]:
            s = c("accent", "  ●  ") if f in entry["forms"] else c("dim", "  ·  ")
            sh = c("gold", "  ✦") if f in entry["shiny_forms"] else c("dim", "  ·")
            print(f"{pretty_form(f):<20}{s} {sh}")
        return

    total = len(species)
    all_forms = sum(len(p["forms"]) for p in species)
    forms_seen = sum(len(e["forms"]) for e in seen.values())
    shinies = shiny_count(dex)
    print(c("accent", "Pokédex", bold=True) + c("dim", f"  ·  {dex['encounters']} encounters"))
    print()
    print(c("dim", "Species   ") + c("accent", bar(len(seen), total, 20)) + c("dim", f" {len(seen)}/{total}"))
    print(c("dim", "Shiny dex ") + c("gold", bar(shinies, total, 20)) + c("dim", f" {shinies}/{total}"))
    print(c("dim", "All forms ") + c("accent", bar(forms_seen, all_forms, 20)) + c("dim", f" {forms_seen}/{all_forms}"))
    print()
    start = 0
    for last, region, roman in GENS:
        names = [p["name"] for p in species[start:last]]
        n = sum(1 for nm in names if nm in seen)
        print(c("dim", f"{region:<7} ") + c("accent", bar(n, len(names), 20)) + c("dim", f" {n}/{len(names)}"))
        start = last

    shiny_list = [(i, p["name"]) for i, p in enumerate(species) if seen.get(p["name"], {}).get("shiny_forms")]
    if shiny_list:
        print()
        print(c("gold", "Shinies ✦", bold=True))
        for i, nm in shiny_list:
            fs = seen[nm]["shiny_forms"]
            extra = "" if fs == ["regular"] else c("dim", " (" + ", ".join(pretty_form(f) for f in fs) + ")")
            print(f"  #{i + 1:03d} {pretty_name(nm)}{extra}")

    collections = [(p["name"], len(seen[p["name"]]["forms"]), len(p["forms"]))
                   for p in species if len(p["forms"]) > 1 and p["name"] in seen]
    if collections:
        complete = [nm for nm, n, t in collections if n == t]
        in_progress = sorted((x for x in collections if x[1] < x[2]), key=lambda x: (-x[1] / x[2], -x[2], x[0]))
        multi = sum(1 for p in species if len(p["forms"]) > 1)
        print()
        print(c("accent", "Form collections", bold=True) + c("dim", f"  {len(complete)}/{multi} complete · pokegreet --dex NAME"))
        for nm, n, t in in_progress[:10]:
            print(f"  {pretty_name(nm):<14}" + c("accent", bar(n, t)) + c("dim", f" {n}/{t}"))
        if len(in_progress) > 10:
            print(c("dim", f"  …and {len(in_progress) - 10} more in progress"))


# ---------- --check ----------

def check():
    """Every pool entry and form rule must exist in the installed sprite data."""
    species = load_species()
    forms = {p["name"]: p["forms"] for p in species}
    problems = []
    groups = [(e["id"], e["pool"]) for e in EVENTS] + [(t["id"], t["pool"]) for t in THEMES] \
        + [(s["id"], s["pool"]) for s in SEASONS.values()]
    for gid, pool in groups:
        bad = [e for e in pool if e not in resolve([e], species)]
        if bad:
            problems.append(f"{gid}: {' '.join(bad)}")
    for name, rule in FORM_RULES.items():
        for month in range(1, 13):
            for hour in range(24):
                form = rule(datetime.datetime(2026, month, 15, hour), {"hemisphere": "north"})
                if form not in forms.get(name, []):
                    problems.append(f"form rule {name}: no form {form!r}")
                    break
    ids = [e["id"] for e in EVENTS] + [t["id"] for t in THEMES] + list(SEASONS)
    if len(ids) != len(set(ids)):
        problems.append("duplicate event/theme ids")
    for p in problems:
        print(p)
    print(f"{len(groups)} pools checked against {DATA_DIR}: " + ("OK" if not problems else f"{len(problems)} problem(s)"))
    sys.exit(1 if problems else 0)


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args and args[0] == "--version":
        print(f"pokegreet {VERSION}  {REPO}")
        return
    cfg = load_config()
    COLORS.update(cfg["colors"])
    if args and args[0] == "--check":
        check()
    elif args and args[0] in ("-d", "--dex"):
        show_dex(args[1] if len(args) > 1 else None)
    elif args and args[0] == "--at":
        if len(args) < 2:
            die("--at needs a date/time, e.g. --at 2026-10-31T23:00")
        try:
            t = datetime.datetime.fromisoformat(args[1])
        except ValueError:
            die(f"bad date/time {args[1]!r}, expected e.g. 2026-10-31T23:00")
        render(*build_encounter(cfg, t, save=False), cfg)
    elif args and args[0] == "--styles":
        show_styles(cfg, datetime.datetime.now())
    elif args:
        die(f"unknown option {args[0]!r} (try --help)")
    else:
        render(*build_encounter(cfg, datetime.datetime.now()), cfg)


if __name__ == "__main__":
    main()
